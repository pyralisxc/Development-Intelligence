DEVINT_PROJECTS_FILE=./config/projects.json
DEVINT_HOST=127.0.0.1
DEVINT_PORT=8787

# Disposable compute only. Development Intelligence does not require durable local graph state.
# DEVINT_SCRATCH_DIR=/tmp
DEVINT_GRAPH_CACHE_SIZE=6
DEVINT_GRAPH_MAX_FILES=10000
DEVINT_GRAPH_MAX_FILE_BYTES=1000000
DEVINT_GRAPH_MAX_RUNTIME_BYTES=2000000
DEVINT_VIEWER_MAX_NODES=450
DEVINT_RUNTIME_TIMEOUT_MS=15000

# Authentication: bearer (default), proxy, or explicit development-only none.
DEVINT_AUTH_MODE=bearer
DEVINT_BEARER_TOKEN=replace-me
# DEVINT_PROXY_SHARED_SECRET=replace-me
# DEVINT_ALLOW_UNAUTHENTICATED=1
# DEVINT_ALLOWED_HOSTS=mcp.example.com
