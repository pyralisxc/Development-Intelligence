DEVINT_PROJECTS_FILE=./config/projects.json
DEVINT_HOST=127.0.0.1
DEVINT_PORT=8787

# Local development/test adapters only. Production uses Cloud Storage + Firestore.
DEVINT_DATA_DIR=./.data
DEVINT_ARTIFACT_DIR=./.data/artifacts
DEVINT_CONTROL_DIR=./.data/control
DEVINT_EPHEMERAL_DIR=./.data/ephemeral

# Production managed state.
# DEVINT_GCS_BUCKET=development-intelligence-private
# DEVINT_FIRESTORE_ENABLED=1
# DEVINT_FIRESTORE_DATABASE=(default)
# DEVINT_FIRESTORE_COLLECTION=development-intelligence-projects
# DEVINT_CLOUD_RUN_JOB_RESOURCE=projects/PROJECT_ID/locations/REGION/jobs/development-intelligence-index

# Authentication: bearer (default), proxy, or explicit development-only none.
DEVINT_AUTH_MODE=bearer
DEVINT_BEARER_TOKEN=replace-me
# DEVINT_PROXY_SHARED_SECRET=replace-me
# DEVINT_ALLOW_UNAUTHENTICATED=1
# DEVINT_ALLOWED_HOSTS=mcp.example.com

DEVINT_CBM_BINARY=codebase-memory-mcp
DEVINT_CBM_VERSION=0.10.8
DEVINT_INDEX_TIMEOUT_MS=1200000
DEVINT_HYDRATE_TIMEOUT_MS=600000
DEVINT_HYDRATION_CACHE_SIZE=3
DEVINT_SOURCE_HISTORY_DEPTH=32
CBM_WORKERS=1
# CBM_MEM_BUDGET_MB=1536

DEVINT_PARITY_MAX_FILES=5000
DEVINT_PARITY_MAX_FILE_BYTES=1000000
DEVINT_PARITY_MAX_RUNTIME_BYTES=2000000
DEVINT_RUNTIME_TIMEOUT_MS=15000
