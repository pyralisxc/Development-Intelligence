DEVINT_PROJECTS_FILE=./config/projects.json
# Hosted services may use one secret JSON env value instead of mounting a registry file.
# DEVINT_PROJECTS_JSON={"project-id":{"repository":"https://github.com/owner/repo.git","defaultRef":"refs/heads/main","allowedRefs":["refs/heads/main"],"credential":{"type":"token-env","env":"GITHUB_TOKEN"}}}
DEVINT_HOST=127.0.0.1
DEVINT_PORT=8787

# Disposable compute only. Development Intelligence does not require durable local graph state.
# DEVINT_SCRATCH_DIR=/tmp
DEVINT_GRAPH_CACHE_SIZE=6
DEVINT_GRAPH_SNAPSHOT_CACHE_SIZE=4
DEVINT_GRAPH_MAX_FILES=10000
DEVINT_GRAPH_MAX_FILE_BYTES=1000000
DEVINT_GRAPH_MAX_RUNTIME_BYTES=2000000
DEVINT_RUNTIME_TIMEOUT_MS=15000

# Authentication modes:
# - oauth: single-owner Workbench sign-in + native OAuth 2.1/PKCE MCP access (recommended for hosted ChatGPT use)
# - private: single-owner browser sign-in + separate static agent bearer credential (convenient for local development)
# - bearer: one bearer credential for every protected request
# - proxy: trust an authenticated gateway via X-Devint-Proxy-Secret
# - none: explicit local-development only, requires DEVINT_ALLOW_UNAUTHENTICATED=1
DEVINT_AUTH_MODE=private
DEVINT_OWNER_PASSWORD=replace-with-a-strong-owner-password
DEVINT_AGENT_TOKEN=replace-with-a-long-random-agent-token
DEVINT_SESSION_SECRET=replace-with-a-separate-long-random-session-secret

# Hosted ChatGPT OAuth mode. Set DEVINT_AUTH_MODE=oauth and uncomment/configure these on the deployment.
# DEVINT_PUBLIC_BASE_URL=https://development-intelligence.example.com
# DEVINT_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
# DEVINT_OAUTH_SCOPES=development-intelligence.read
# DEVINT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DEVINT_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DEVINT_OAUTH_ALLOW_LOOPBACK=1 # local OAuth clients only; do not enable on hosted deployments unless required

# Optional static OAuth client configuration instead of dynamic registration.
# DEVINT_OAUTH_CLIENT_ID=chatgpt
# DEVINT_OAUTH_CLIENT_NAME=ChatGPT
# DEVINT_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector/oauth/<exact-callback-id>

# Browser-session settings.
# DEVINT_SESSION_TTL_SECONDS=43200
# DEVINT_COOKIE_SECURE=0 # local HTTP only; leave secure cookies enabled for HTTPS deployments

# Alternative bearer/proxy modes:
# DEVINT_BEARER_TOKEN=replace-me
# DEVINT_PROXY_SHARED_SECRET=replace-me
# DEVINT_ALLOW_UNAUTHENTICATED=1
# DEVINT_ALLOWED_HOSTS=development-intelligence.example.com
