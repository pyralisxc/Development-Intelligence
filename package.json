{
  "name": "development-intelligence",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "description": "Project-neutral intrinsic development intelligence over Git, source, runtime evidence, and technical representations.",
  "engines": {
    "node": ">=22.13.0 <23 || >=23.4.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:server:runtime": "tsc -p tsconfig.runtime.json",
    "build:runtime": "npm run build:server:runtime && npm run build:viewer",
    "build:viewer": "esbuild src/viewerClient.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=dist/public/viewer.js",
    "build": "npm run build:server && npm run build:viewer",
    "verify:hosted": "node scripts/verify-hosted-production.mjs",
    "vcr:plan": "npm run build:server && node scripts/vcr-image-maintenance.mjs",
    "graph:seal": "node dist/src/graphCli.js seal",
    "graph:check": "node dist/src/graphCli.js check",
    "start": "node dist/src/http.js",
    "stdio": "node dist/src/stdio.js"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/napi": "0.45.3",
    "@bufbuild/protobuf": "^2.17.0",
    "@clerk/backend": "3.32.0",
    "@scip-code/scip": "^0.10.0",
    "@sourcegraph/scip-typescript": "0.6.2",
    "@upstash/redis": "1.38.4",
    "@vercel/drives": "^1.0.0",
    "@vercel/sandbox": "^4.1.0",
    "graphology": "0.26.0",
    "npm": "10.9.2",
    "sigma": "3.0.3",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-powershell": "0.26.6",
    "typescript": "5.8.3",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
