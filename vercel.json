{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "work/**": false
    }
  },
  "crons": [
    {
      "path": "/internal/reconcile-canonical",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/internal/vcr-retention",
      "schedule": "17 */6 * * *"
    }
  ]
}
