{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore-command.sh",
  "git": {
    "deploymentEnabled": {
      "work/**": false
    }
  },
  "schedules": {
    "account-dispatch-readiness": {
      "schedule": "* * * * *",
      "path": "/internal/account-dispatch-readiness",
      "requestMethod": "POST"
    }
  },
  "crons": [
    {
      "path": "/internal/reconcile-canonical",
      "schedule": "*/5 * * * *"
    }
  ]
}
